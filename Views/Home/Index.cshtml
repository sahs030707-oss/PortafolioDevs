@model Perfil
@{
    ViewData["Title"] = $"{Model.Nombre} | Portafolio";
    ViewData["Nombre"] = Model.Nombre;
}

<section id="inicio" class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1>Hola, soy @Model.Nombre.</h1>
                <p class="hero-role">@Model.Rol</p>
                <p class="hero-lead">@Model.Resumen</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="cta" href="#proyectos">Ver mis proyectos</a>
                    <a class="cta cta-ghost" href="#contacto">Contactarme</a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="pipeline" aria-label="Resultado del pipeline de despliegue">
                    <div class="pipeline-bar">
                        <span class="pipeline-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                        azure-pipelines.yml
                    </div>
                    <ul class="pipeline-body">
                        <li class="step"><span class="ok">✔</span> Build: compilación y publicación <span class="time">42 s</span></li>
                        <li class="step"><span class="ok">✔</span> Deploy: Azure App Service <span class="time">18 s</span></li>
                        <li class="step step-live"><span class="ok">●</span> En línea: @Model.UrlSitio</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="sobre-mi" class="page-section page-section-white">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <h2>Sobre mí</h2>
                <p class="prose">@Model.SobreMi</p>
            </div>
            <div class="col-lg-5">
                <dl class="facts">
                    @foreach (var d in Model.Datos)
                    {
                        <div class="fact">
                            <dt>@d.Etiqueta</dt>
                            <dd>@d.Valor</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    </div>
</section>

<section id="habilidades" class="page-section">
    <div class="container">
        <h2>Habilidades</h2>
        <div class="row g-4 mt-1">
            @foreach (var g in Model.Habilidades)
            {
                <div class="col-md-6">
                    <h3 class="group-title">@g.Nombre</h3>
                    <div class="chips">
                        @foreach (var item in g.Items)
                        {
                            <span class="chip">@item</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="proyectos" class="page-section page-section-white">
    <div class="container">
        <h2>Proyectos</h2>
        <div class="projects">
            @foreach (var p in Model.Proyectos)
            {
                <article class="project">
                    <h3>@p.Titulo</h3>
                    <p class="prose">@p.Descripcion</p>
                    <div class="chips mb-3">
                        @foreach (var t in p.Tecnologias)
                        {
                            <span class="chip chip-azure">@t</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        @if (p.UrlDemo is not null)
                        {
                            <a class="text-link" href="@p.UrlDemo" target="_blank" rel="noopener">Ver sitio</a>
                        }
                        @if (p.UrlRepo is not null)
                        {
                            <a class="text-link" href="@p.UrlRepo" target="_blank" rel="noopener">Ver código en GitHub</a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section id="contacto" class="page-section contact">
    <div class="container">
        <h2>Contacto</h2>
        <p class="prose">¿Tienes una idea, una oportunidad o una pregunta? Escríbeme.</p>
        <a class="contact-mail" href="mailto:@Model.Correo">@Model.Correo</a>
        <div class="d-flex flex-wrap gap-3 mt-4">
            <a class="cta" href="@Model.GitHub" target="_blank" rel="noopener">GitHub</a>
            <a class="cta cta-ghost" href="@Model.LinkedIn" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </div>
</section>
